# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=

# --- Auth: JWT --------------------------------------------------------------
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Auth: cookies ------------------------------------------------------
# Leave blank for localhost dev. Set to your API's domain in production
# (e.g. "api.smartcart.com") so cookies scope correctly.
COOKIE_DOMAIN=

# --- Frontend ----------------------------------------------------------
# Used for CORS (see src/config/cors.js) and for redirecting the browser
# back after an OAuth login. Comma-separate multiple origins if more than
# one frontend must reach this API (e.g. staging + production). REQUIRED in
# production — the server refuses to start without it rather than falling
# back to allowing any origin.
FRONTEND_URL=http://localhost:5173

# --- Logging ----------------------------------------------------------
# Optional. Defaults: 'info' in production, 'debug' in development,
# 'silent' during tests. See src/config/logger.js.
LOG_LEVEL=

# --- Google OAuth ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Add GOOGLE_CALLBACK_URL below as
# an Authorized redirect URI in that console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Facebook OAuth -------------------------------------------------------
# Create an app at https://developers.facebook.com/apps (add the "Facebook
# Login" product). Add FACEBOOK_CALLBACK_URL as a Valid OAuth Redirect URI.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# --- Passkeys / WebAuthn --------------------------------------------------
# No external account needed — WebAuthn is a browser/OS standard, not a
# third-party service. RP_ID must be the bare domain (no scheme/port) that
# will host the frontend; ORIGIN must be its full URL.
WEBAUTHN_RP_NAME=SmartCart
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Admin seed script (src/scripts/seedAdmin.js) -------------------------
# Optional: lets `npm run seed:admin` run without passing --email/--password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Supabase Storage (image storage) --------------------------------------
# Shared by every feature that stores images (Category Management now,
# Product Management later — see src/services/imageStorageService.js).
# SUPABASE_URL: your project's URL, e.g. https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY: Project Settings > API > API Keys > "Secret keys"
#   (starts with sb_secret_...). Server-side only — this bypasses Row Level
#   Security. NEVER expose it to the frontend or commit it. Do not use the
#   "Publishable key" (sb_publishable_...) here — that one is client-safe
#   and has no storage write access.
# SUPABASE_STORAGE_BUCKET: name of a bucket you created for app images
#   (public read, so uploaded images are viewable via their URL).
# Leave any of these blank to disable image upload endpoints (they'll
# respond 503 instead of erroring).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# --- PayHere payment gateway (src/services/payhereService.js, --------------
# --- src/controllers/paymentController.js) ---------------------------------
# Sign up / get sandbox credentials at https://sandbox.payhere.lk (business
# sandbox account) — see backend/docs/payhere-integration.md for the full
# setup + local-testing notes.
#
# PAYHERE_MERCHANT_ID / PAYHERE_MERCHANT_SECRET: from your PayHere
#   merchant dashboard (Integrations > Domains & Credentials). The secret is
#   used ONLY on the server (to generate/verify hashes) and must never be
#   sent to the frontend, logged, or committed.
# PAYHERE_SANDBOX: "true" to use PayHere's sandbox environment (default —
#   deliberately fails safe if left blank). Set to the literal string
#   "false" to go live.
# PAYHERE_CURRENCY: the single currency SmartCart charges in. Defaults to
#   LKR if unset.
# PAYHERE_RETURN_URL / PAYHERE_CANCEL_URL: frontend pages PayHere redirects
#   the shopper's browser back to after payment/cancellation. These are
#   NOT how payment success is determined (see PAYHERE_NOTIFY_URL) — the
#   frontend must re-fetch the order from the backend on those pages.
# PAYHERE_NOTIFY_URL: your backend's PUBLICLY ACCESSIBLE
#   POST /api/payments/payhere/notify endpoint. PayHere calls this
#   server-to-server; it cannot reach a plain localhost URL — use a tunnel
#   (e.g. ngrok) for local end-to-end testing. Leave any of these blank to
#   disable the PayHere endpoints (they respond 503 instead of erroring).
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=LKR
PAYHERE_RETURN_URL=http://localhost:5173/payment/return
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
PAYHERE_NOTIFY_URL=http://localhost:5000/api/payments/payhere/notify
